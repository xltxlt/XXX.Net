<#@ template language="C#" #>
<#@ output extension=".vue" #>

<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text.Json" #>

<#@ assembly name="System.Text.Json" #>

<#@ parameter name="ComponentName" type="System.String" #>
<#@ parameter name="ServiceName" type="System.String" #>
<#@ parameter name="ApiServiceName" type="System.String" #>
<#@ parameter name="FieldsJson" type="System.String" #>

<#
    // ============================
    // 参数安全处理
    // ============================

    var componentName = ComponentName ?? string.Empty;
    var serviceName = ServiceName ?? string.Empty;
    var apiServiceName = ApiServiceName ?? string.Empty;

    // ============================
    // FieldsJson 反序列化
    // ============================

    var fields = new List<FieldDef>();

    if (!string.IsNullOrWhiteSpace(FieldsJson))
    {
        try
        {
            fields = JsonSerializer.Deserialize<List<FieldDef>>(
                FieldsJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<FieldDef>();
        }
        catch (Exception ex)
        {
            throw new Exception(
                $"FieldsJson 反序列化失败：{ex.Message}\nFieldsJson：{FieldsJson}",
                ex);
        }
    }
#>

<script setup lang='ts'>

import PageForm from '@/components/PageForm/PageForm.vue';
import { onMounted,ref } from 'vue';
import { ElMessage } from 'element-plus';
import { <#= ApiServiceName #> } from "@/api/index.ts";

import {
    type TempEditPageData,
    PageFormType
} from '@/components/PageForm';


const { pars } = defineProps<{
    pars?: Record<string, any>
}>();

const emit = defineEmits([
    'closeDialog',
    'refreshList'
]);

const tempForm = ref<TempEditPageData>({
    loading: false,
    hideBtn:pars?.lock=='lock' ? true : false,
    form: [
<#
    foreach (var field in fields)
    {
        var formType = field.FormType.ToString();
        var label = field.Label ?? string.Empty;
        var fieldName = field.FieldName ?? string.Empty;
#>
        {
            formType: PageFormType.<#= formType #>,
            label: "<#= label #>",
            fieldName: "<#= fieldName #>"
        },
<#
    }
#>
    ],

    rules: {
    },

    formData: {
        id: pars?.id ?? null,
    },

    options: {
    },
});

<#
if (!string.IsNullOrWhiteSpace(apiServiceName) &&
    !string.IsNullOrWhiteSpace(componentName))
{
#>
onMounted(async () => {

    var res=await <#= apiServiceName #>.api<#= componentName #>DetailoptionGet(pars?.id);
    

        tempForm.value.options =  Object.assign(
                tempForm.value.options,
                res.data.data?.options ?? {}
            );
        tempForm.value.formData =
            Object.assign(
                tempForm.value.formData,
                res.data.data?.detail ?? {}
            );
});
 

<#
}
#>

const sumbit = () => {

    const formData = {
        ...tempForm.value.formData
    };


<#
if (!string.IsNullOrWhiteSpace(apiServiceName) &&
    !string.IsNullOrWhiteSpace(componentName))
{
#>

    <#= apiServiceName #>.api<#= componentName #>AddorupdatePost(formData)
        .then((res) => {

            if (res.data.statusCode != 200) {

                ElMessage({
                    message: '操作失败',
                    type: 'error',
                    plain: true,
                });

                return;
            }

            ElMessage({
                message: '操作成功',
                type: 'success',
                plain: true,
            });

            emit('closeDialog');
            emit('refreshList');
        })
        .finally(() => {
        });

<#
}
#>

};

</script>

<template>

    <div class="edit-page">

        <page-form
            :temp-form="tempForm"
            @on-submit="sumbit"
        >
        </page-form>

    </div>

</template>

<style lang='less' scoped>

.edit-page {
    height: 100%;
    overflow-y: scroll;
}

</style>

<#+

    public class FieldDef
    {
        public string Label { get; set; } = string.Empty;

        public string FieldName { get; set; } = string.Empty;

        public string FormType { get; set; }= "Input";
    }

#>