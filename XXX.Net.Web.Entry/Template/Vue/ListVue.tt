<#@ template language="C#" #>
<#@ output extension=".vue" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text.Json" #>
<#@ assembly name="System.Text.Json" #>

<#@ parameter name="ComponentName" type="System.String" #>
<#@ parameter name="ServiceName" type="System.String" #>
<#@ parameter name="ApiServiceName" type="System.String" #>
<#@ parameter name="PageName" type="System.String" #>
<#@ parameter name="addBtn" type="System.Boolean" #>
<#@ parameter name="editBtn" type="System.Boolean" #>
<#@ parameter name="delBtn" type="System.Boolean" #>
<#@ parameter name="lockBtn" type="System.Boolean" #>

<#
    // 缓存常用字符串，避免重复调用 Replace
    var baseServiceName = ServiceName.Replace("Service", "");
#>

<template>
  <PageInfo :pageConfig="pageConfig" ref="pageInfoRef" />
</template>

<script setup lang="ts">
import { ref } from "vue";
import { ElMessage, ElMessageBox } from "element-plus";
import PageInfo from "@/components/ListPage/PageInfo.vue";
import { <#= ApiServiceName #> } from "@/api/index.ts";
import <#= PageName #>Edit from "./<#= PageName #>Edit.vue";
import { PagedSearchType, type TempListPageConfig } from "@/components/ListPage";
import { handleSumbitResBox } from "@/utils/common"; // 假设工具函数在此

const pageInfoRef = ref();

const pageConfig: TempListPageConfig = {
  url: <#= ApiServiceName #>.api<#= baseServiceName #>PagelistPost.bind(<#= ApiServiceName #>),
  optionUrl: <#= ApiServiceName #>.api<#= baseServiceName #>PageoptionGet.bind(<#= ApiServiceName #>),
  pageFun: {
<# if (addBtn) { #>
    add: (data: any) => {
      return {
        title: "新增",
        comp: <#= PageName #>Edit,
        height: "70%",
        pars: {},
      };
    },
<# } #>
<# if (editBtn) { #>
    edit: (data: any) => {
      return {
        title: "修改",
        comp: <#= PageName #>Edit,
        height: "70%",
        pars: {
          id: data?.id, // 使用行数据的 id
        },
      };
    },
<# } #>
<# if (delBtn) { #>
    batchDel: async (data: any[]) => {
      const ids = data.map(item => item.id);
      if (ids.length === 0) {
        ElMessage({ type: 'info', message: '请选择要删除的记录' });
        return;
      }
      if (ids.length !== 1) {
        ElMessage({ type: 'info', message: '批量删除仅支持单条记录' });
        return;
      }
      const res = await <#= ApiServiceName #>.api<#= ComponentName #>BatchlogicdeletePost(ids);
      handleSumbitResBox(res, '删除成功', () => {
        pageInfoRef.value?.onRefresh();
      });
    },
    del: async (data: any) => {
      await ElMessageBox.confirm('此操作将永久删除该记录, 是否继续?', '提示', {
        confirmButtonText: '确定',
        cancelButtonText: '取消',
        type: 'warning',
      });
      const res = await <#= ApiServiceName #>.api<#= ComponentName #>LogicdeleteIdPost(data.id);
      handleSumbitResBox(res, '删除成功', () => {
        pageInfoRef.value?.onRefresh();
      });
    },
<# } #>
<# if (lockBtn) { #>
    lock: (data: any) => {
      return {
        title: "查看",
        comp: <#= PageName #>Edit,
        height: "70%",
        pars: {
          id: data?.id, // 使用行数据的 id
          lock: "lock",
        },
      };
    },
<# } #>
  },
};
</script>

<style lang="less" scoped>
// 如果需要额外样式，可在此添加
</style>